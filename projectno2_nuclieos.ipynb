   ],
   "source": [
    "# 5) Graph state\n",
    "class GraphState(TypedDict):\n",
    "    question: str\n",
    "    context: str\n",
    "    answer: str\n",
    "\n",
    "\n",
    "def retrieve_node(state: GraphState):\n",
    "    results = retriever.invoke(state[\"question\"])\n",
    "    context = \"\\n\\n---\\n\\n\".join(doc.page_content for doc in results)\n",
    "    return {\"context\": context}\n",
    "\n",
    "\n",
    "def answer_node(state: GraphState):\n",
    "    context1 = state[\"context\"]\n",
    "    question1 = state[\"question\"]\n",
    "    prompt = f\"\"\"answer only from context ={context1} or question ={question1}\"\"\"\n",
    "    response = llm.invoke(prompt)\n",
    "    return {\"answer\": response.content}\n",
    "\n",
    "\n",
    "# 7) Build graph\n",
    "graph = StateGraph(GraphState)\n",
    "graph.add_node(\"retrieve\", retrieve_node)\n",
    "graph.add_node(\"answer\", answer_node)\n",
    "graph.add_edge(START, \"retrieve\")\n",
    "graph.add_edge(\"retrieve\", \"answer\")\n",
    "graph.add_edge(\"answer\", END)\n",
    "\n",
    "app = graph.compile()\n",
    "\n",
    "\n",
    "# 8) Run\n",
    "result = app.invoke(\n",
    "    {\n",
    "        \"question\": \"How many days do I have to request a refund?\",\n",
    "        \"context\": \"\",\n",
    "        \"answer\": \"\",\n",
    "    }\n",
    ")\n",
    "print(result[\"answer\"])\n"
   ]
  }
