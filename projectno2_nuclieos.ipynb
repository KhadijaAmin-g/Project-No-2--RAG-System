    "from pathlib import Path\n",
    "from typing import TypedDict\n",
    "import os\n",
    "\n",
    "from dotenv import load_dotenv\n",
    "from langchain_chroma import Chroma\n",
    "from langchain_core.documents import Document\n",
    "from langchain_community.document_loaders import TextLoader\n",
    "from langchain_groq import ChatGroq\n",
    "from langchain_huggingface import HuggingFaceEmbeddings\n",
    "from langchain_text_splitters import RecursiveCharacterTextSplitter\n",
    "from langgraph.graph import END, START, StateGraph\n",
    "\n",
    "\n",
    "load_dotenv()\n",
    "api_key = os.getenv(\"groq_api_key\")
    "#do this portion with teh help of ai date or load \n",
    "DATE_BY_FILE = {\n",
    "    \"hr_faq.txt\": \"2023-01-01\",\n",
    "    \"leave_policy_v1.txt\": \"2022-06-01\",\n",
    "    \"leave_policy_v2.txt\": \"2024-01-01\",\n",
    "    \"remote_work_policy.txt\": \"2022-06-01\",\n",
    "}\n",
    "\n",
    "def load_corpus_documents(corpus_dir: str = \"corpus\") -> list[Document]:\n",
    "    corpus_path = Path(corpus_dir)\n",
    "    docs = []\n",
    "\n",
    "    for file_path in corpus_path.glob(\"*.txt\"):\n",
    "        for doc in TextLoader(str(file_path), encoding=\"utf-8\").load():\n",
    "            doc.metadata[\"source\"] = file_path.name\n",
    "            doc.metadata[\"date\"] = DATE_BY_FILE.get(file_path.name, \"\")\n",
    "            docs.append(doc)\n",
    "    if not docs:\n",
    "        raise ValueError(f\"No .txt files found in {corpus_path.resolve()}\")\n",
    "    return docs\n",
    "\n",
    "\n",
    "# 1) Load corpus from files instead of hardcoding documents in memory\n",
    "docs = load_corpus_documents(\"corpus\")\n",
    "\n",
    "# 2) Split\n",
    "splitter = RecursiveCharacterTextSplitter(chunk_size=200, chunk_overlap=20)\n",
    "chunks = splitter.split_documents(docs)\n",
    "\n",
    "# 3) Vector store\n",
    "embeddings = HuggingFaceEmbeddings(model_name=\"sentence-transformers/all-MiniLM-L6-v2\")\n",
    "vectorstore = Chroma.from_documents(chunks, embeddings)\n",
    "retriever = vectorstore.as_retriever(search_kwargs={\"k\": 3})\n",
    "\n",
    "# 4) LLM\n",
    "llm = ChatGroq(\n",
    "    model=\"llama-3.3-70b-versatile\",\n",
    "    groq_api_key=api_key,\n",
    ")\n"
   ]
  },
